  "scope": "Retrospective counterfactual gate replay on fixed cached TEST banks, fixed G4 and unchanged candidate draws. No GPU or new decoding, no confirmation or runtime claim. Token gate is compression-only screening of the original beam; it does not reproduce the combined HF retry or no-speech policy.",
  "protocol": {
    "original": "max_window CR_UTF8(text)>2.4",
    "word": "max_window r4,3(top_beam)>0, original normalized word feature",
    "alternative": "max_window CR_token_ids(top_beam generated tokens including natural EOS)>1.35, 2-byte little-endian HF 4.57.6 compression",
    "aggregation": "recording flags are OR across windows; selected output is N+R on every window if triggered, B otherwise",
    "WER": "Within-language sum(S+D+I)/sum(reference words), equal 5-language mean, then equal 3-checkpoint mean.",
    "calls": "All triggered seed-recordings / all seed-recordings; acquired windows reported separately.",
    "retention": "1 - mean_seed mean_language sum_positive (E_B-E_N)*1{gate off}/N_language divided by mean_seed mean_language sum_positive(E_B-E_N)/N_language; not pooled edits and not average per-seed retention.",
    "test_tuning": "No threshold fit or search; fixed requested 2.4, 0 and HF 1.35. Exploratory post hoc evaluation."
  },
